PORT=3000
CORS_ORIGIN=http://localhost:8080

# AWS
AWS_REGION=
# Leave these unset to use your AWS CLI profile (~/.aws) or an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# DynamoDB
DYNAMODB_PROJECTS_TABLE=
# Uncomment to use DynamoDB Local
# DYNAMODB_ENDPOINT=http://localhost:8000

# Cognito (same user pool and app client as the frontend)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Analysis
# `local` (default) runs the worker as a child process of the API and needs git installed.
# `ecs` starts it as a Fargate task with the settings below.
ANALYSIS_RUNNER=local
# ANALYZER_CLUSTER=
# ANALYZER_TASK_DEFINITION=
# Comma-separated; public subnets so the task can reach GitHub and Bedrock without a NAT gateway.
# ANALYZER_SUBNETS=
# ANALYZER_SECURITY_GROUPS=
# Container name in the task definition (defaults to `analyzer`).
# ANALYZER_CONTAINER_NAME=analyzer

# Bedrock models used by the analyzer worker (with AWS_REGION and the AWS credentials above).
# Claude IDs (containing "anthropic.") use the Anthropic SDK; any other Bedrock model ID uses
# the Converse API. The IAM user/role needs bedrock:InvokeModel (plus
# bedrock-mantle:CreateInference for bare anthropic.claude-* IDs).
# Claude on Bedrock needs the Anthropic use-case form submitted for the account, so until
# then these are models that need no form. Later: BEDROCK_MODEL=anthropic.claude-opus-5-5
BEDROCK_MODEL=qwen.qwen3-coder-480b-a35b-v1:0
# Tried when the main model is unavailable, refuses, or keeps returning unusable output.
# Leave empty to turn off.
BEDROCK_FALLBACK_MODEL=us.amazon.nova-2-lite-v1:0
