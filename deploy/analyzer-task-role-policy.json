{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-2:094289742685:table/struct",
        "arn:aws:dynamodb:us-east-2:094289742685:table/struct/index/*"
      ]
    },
    {
      "Sid": "BedrockModels",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:us-east-2:094289742685:inference-profile/*"
      ]
    }
  ]
}
