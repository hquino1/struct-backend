{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-2:094289742685:table/struct",
        "arn:aws:dynamodb:us-east-2:094289742685:table/struct/index/*"
      ]
    },
    {
      "Sid": "LaunchAnalyzer",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:us-east-2:094289742685:task-definition/struct-analyzer:*",
      "Condition": {
        "ArnEquals": { "ecs:cluster": "arn:aws:ecs:us-east-2:094289742685:cluster/struct-cluster" }
      }
    },
    {
      "Sid": "PassAnalyzerRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::094289742685:role/struct-ecs-execution-role",
        "arn:aws:iam::094289742685:role/struct-analyzer-task-role"
      ],
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    }
  ]
}
